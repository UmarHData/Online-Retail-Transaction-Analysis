      <aliases enabled='yes' />
      <column caption='Total Orders' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5815853674799104]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [TransactionType] = &quot;Sale&quot;&#10;    THEN [InvoiceNo]&#10;    END&#10;)' />
      </column>
      <column caption='Net Revenue' datatype='real' default-format='c&quot;£&quot;#,##0;-&quot;£&quot;#,##0' name='[Calculation_5815853676601345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalTransactionValue])' />
      </column>
      <column caption='Unique Customers' datatype='integer' default-format='n#,##0;-#,##0' name='[Calculation_5815853676748802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#10;    IF [TransactionType] = &quot;Sale&quot;&#10;    THEN [CustomerID]&#10;    END&#10;)' />
      </column>
      <column caption='Average Order Value' datatype='real' default-format='c&quot;£&quot;#,##0.00;-&quot;£&quot;#,##0.00' name='[Calculation_5815853676924931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [TransactionType] = &quot;Sale&quot;&#10;    THEN [TotalTransactionValue]&#10;    ELSE 0&#10;    END&#10;)&#10;/&#10;COUNTD(&#10;    IF [TransactionType] = &quot;Sale&quot;&#10;    THEN [InvoiceNo]&#10;    END&#10;)' />
      </column>
